-- ========== FPS FUNCTIONS ==========
local function applyPostEffects(on)
    if on then
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("PostEffect") then v:Destroy() end
        end
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        Lighting.Brightness = 2
    else
        Lighting.GlobalShadows = true
        Lighting.FogEnd = 10000
        Lighting.Brightness = 1
    end
end

local function applyMaterials(on)
    for _, inst in ipairs(workspace:GetDescendants()) do
        if inst:IsA("BasePart") then
            if player.Character and inst:IsDescendantOf(player.Character) then continue end
            if on then
                originalData.parts[inst] = { Material = inst.Material, Reflectance = inst.Reflectance }
                inst.Material = Enum.Material.SmoothPlastic
                inst.Reflectance = 0
            else
                if originalData.parts[inst] then
                    inst.Material = originalData.parts[inst].Material
                    inst.Reflectance = originalData.parts[inst].Reflectance
                end
            end
        end
    end
end

local function applyDecals(on)
    for _, inst in ipairs(workspace:GetDescendants()) do
        if inst:IsA("Texture") or inst:IsA("Decal") then
            if player.Character and inst:IsDescendantOf(player.Character) then continue end
            if on then
                originalData.decals[inst] = inst.Transparency
                inst.Transparency = 1
            else
                if originalData.decals[inst] then
                    inst.Transparency = originalData.decals[inst]
                end
            end
        end
    end
end

local function applyTerrain(on)
    local t = workspace:FindFirstChild("Terrain")
    if not t then return end
    if on then
        originalData.terrain = {
            WaterWaveSize = t.WaterWaveSize,
            WaterWaveSpeed = t.WaterWaveSpeed,
            WaterReflectance = t.WaterReflectance,
            WaterTransparency = t.WaterTransparency,
        }
        t.WaterWaveSize = 0
        t.WaterWaveSpeed = 0
        t.WaterReflectance = 0
        t.WaterTransparency = 1
    else
        if originalData.terrain.WaterWaveSize then
            t.WaterWaveSize = originalData.terrain.WaterWaveSize
            t.WaterWaveSpeed = originalData.terrain.WaterWaveSpeed
            t.WaterReflectance = originalData.terrain.WaterReflectance
            t.WaterTransparency = originalData.terrain.WaterTransparency
        end
    end
end

local function applyAll()
    applyPostEffects(cfg.removePostEffects)
    applyMaterials(cfg.flatMaterials)
    applyDecals(cfg.hideDecals)
    applyTerrain(cfg.flatTerrain)
    if cfg.disableShadows then Lighting.GlobalShadows = false end
    pcall(function() settings().Rendering.QualityLevel = cfg.qualityLevel end)
    pcall(function() settings().Physics.AllowSleep = cfg.physicsSleep end)
end

local function revertAll()
    applyPostEffects(false)
    applyMaterials(false)
    applyDecals(false)
    applyTerrain(false)
    Lighting.GlobalShadows = true
    pcall(function() settings().Rendering.QualityLevel = 21 end)
    pcall(function() settings().Physics.AllowSleep = false end)
end

