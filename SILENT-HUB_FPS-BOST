-- ========== SHOW MAIN UI ==========
local function showMainUI()
    mainFrame.Visible = true
    mainFrame.Size = UDim2.new(0, 300, 0, 0)
    mainFrame.Position = UDim2.new(0.5, -150, 0.5, 0)
    tw(mainFrame, TI_MED, {
        Size = UDim2.new(0, 300, 0, 400),
        Position = UDim2.new(0.5, -150, 0.5, -200),
    })
end

-- ========== MASTER ON/OFF ==========
masterBtn.MouseButton1Click:Connect(function()
    masterEnabled = not masterEnabled
    if masterEnabled then
        masterBtn.Text = "ON"
        tw(masterBtn, TI_FAST, { BackgroundColor3 = C.toggleOn, TextColor3 = C.onGreen })
        applyAll()
    else
        masterBtn.Text = "OFF"
        tw(masterBtn, TI_FAST, { BackgroundColor3 = C.toggleOff, TextColor3 = C.offRed })
        revertAll()
    end
end)

-- ========== MINIMIZE ==========
minBtn.MouseButton1Click:Connect(function()
    tw(mainFrame, TI_FAST, {
        Size = UDim2.new(0, 300, 0, 0),
        Position = UDim2.new(0.5, -150, 0.5, 0),
    })
    task.delay(0.2, function()
        mainFrame.Visible = false
        popupBtn.ImageTransparency = 1
        popupBtn.Visible = true
        tw(popupBtn, TI_MED, { ImageTransparency = 0 })
    end)
end)

popupBtn.MouseButton1Click:Connect(function()
    tw(popupBtn, TI_FAST, { ImageTransparency = 1 })
    task.delay(0.2, function()
        popupBtn.Visible = false
        showMainUI()
    end)
end)

popupBtn.MouseEnter:Connect(function()
    tw(popupBtn, TI_FAST, { ImageColor3 = Color3.fromRGB(255, 255, 255) })
end)
popupBtn.MouseLeave:Connect(function()
    tw(popupBtn, TI_FAST, { ImageColor3 = Color3.fromRGB(200, 200, 210) })
end)

-- ========== CLOSE ==========
closeBtn.MouseButton1Click:Connect(function()
    warnFrame.Visible = true
    warnFrame.Size = UDim2.new(0, 260, 0, 0)
    tw(warnFrame, TI_MED, { Size = UDim2.new(0, 260, 0, 140) })
end)

warnBackBtn.MouseButton1Click:Connect(function()
    tw(warnFrame, TI_FAST, { Size = UDim2.new(0, 260, 0, 0) })
    task.delay(0.2, function() warnFrame.Visible = false end)
end)

warnCloseBtn.MouseButton1Click:Connect(function()
    revertAll()
    tw(mainFrame, TI_FAST, { BackgroundTransparency = 1 })
    tw(warnFrame, TI_FAST, { BackgroundTransparency = 1 })
    task.delay(0.25, function()
        screenGui:Destroy()
    end)
end)

