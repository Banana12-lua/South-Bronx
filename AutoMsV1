local waterBar   = mkProgressCard("Water (20s)",17)
local sugarBar   = mkProgressCard("Sugar (1s)",18)
local gelatinBar = mkProgressCard("Gelatin (1s)",19)
local bagBar     = mkProgressCard("Bag (45s)",20)

local function cookLoop()
    while running do
        if equipTool("Water") then
            statusLabel.Text = "● Cooking Water..."
            statusLabel.TextColor3 = C.text
            if waterBar then
                waterBar.Size = UDim2.new(0,0,1,0)
                waterBar:TweenSize(UDim2.new(1,0,1,0),Enum.EasingDirection.InOut,Enum.EasingStyle.Linear,20,true)
            end
            holdE(0.7) task.wait(20)
        end
        if equipTool("Sugar Block Bag") then
            statusLabel.Text = "● Cooking Sugar..."
            if sugarBar then sugarBar.Size = UDim2.new(0,0,1,0) sugarBar:TweenSize(UDim2.new(1,0,1,0),Enum.EasingDirection.InOut,Enum.EasingStyle.Linear,1,true) end
            holdE(0.7) task.wait(1)
        end
        if equipTool("Gelatin") then
            statusLabel.Text = "● Cooking Gelatin..."
            if gelatinBar then gelatinBar.Size = UDim2.new(0,0,1,0) gelatinBar:TweenSize(UDim2.new(1,0,1,0),Enum.EasingDirection.InOut,Enum.EasingStyle.Linear,1,true) end
            holdE(0.7) task.wait(1)
        end
        statusLabel.Text = "● Waiting..."
        if bagBar then bagBar.Size = UDim2.new(0,0,1,0) bagBar:TweenSize(UDim2.new(1,0,1,0),Enum.EasingDirection.InOut,Enum.EasingStyle.Linear,45,true) end
        task.wait(45)
        if equipTool("Empty Bag") then
            statusLabel.Text = "● Collecting..."
            holdE(0.7) task.wait(1)
        end
    end
    statusLabel.Text = "● IDLE"
    statusLabel.TextColor3 = C.textMid
end

