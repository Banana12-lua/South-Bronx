-- ========== SOUND HELPER (FIXED - NO HTTP 404) ==========
local function playSound(id, vol)
    task.spawn(function()
        pcall(function()
            local s = Instance.new("Sound")
            s.SoundId = "rbxassetid://" .. tostring(id)
            s.Volume = vol or 0.5
            s.RollOffMaxDistance = 0
            s.Parent = SoundService
            -- Load sound (avoid 404 if id invalid)
            local success, err = pcall(function() s:Play() end)
            if not success then
                s:Destroy()
                return
            end
            task.delay(5, function()
                pcall(function() s:Destroy() end)
            end)
        end)
    end)
end

