            autoSell() task.wait(0.5)
        end
    end)
end

-- ========== DELETE MODE ==========
local function undoLast()
    if #deletedObjects == 0 then notify("Undo", "Tidak ada objek untuk dikembalikan!", "error") return end
    local obj = table.remove(deletedObjects)
    if obj and obj.instance and obj.originalParent then
        pcall(function()
            obj.instance.Parent = obj.originalParent
            if obj.transparency ~= nil then obj.instance.Transparency = obj.transparency end
            if obj.canCollide ~= nil then obj.instance.CanCollide = obj.canCollide end
        end)
    end
    safePlaySound(SOUND_NOTIF, 0.5)
    notify("Undo", "Objek dikembalikan!", "success")
end

local function undoAll()
    for i = #deletedObjects, 1, -1 do
        local obj = deletedObjects[i]
        pcall(function()
            if obj and obj.instance and obj.originalParent then
                obj.instance.Parent = obj.originalParent
                if obj.transparency ~= nil then obj.instance.Transparency = obj.transparency end
                if obj.canCollide ~= nil then obj.instance.CanCollide = obj.canCollide end
            end
        end)
    end
    deletedObjects = {}
    safePlaySound(SOUND_NOTIF, 0.5)
    notify("Undo All", "Semua objek dikembalikan!", "success")
end

local function deleteAllWalls()
    local keywords = {"wall","door","roof","gate","fence","window","dinding","pintu","atap","pagar"}
    local count = 0
    for _, inst in pairs(workspace:GetDescendants()) do
        if inst:IsA("BasePart") or inst:IsA("UnionOperation") or inst:IsA("MeshPart") then
            if not (player.Character and inst:IsDescendantOf(player.Character)) then
                local nm = inst.Name:lower()
                for _, kw in ipairs(keywords) do
                    if nm:find(kw) then
                        table.insert(deletedObjects, {
                            instance = inst,
                            originalParent = inst.Parent,
                            transparency = inst.Transparency,
                            canCollide = inst.CanCollide,
                        })
                        inst.Transparency = 1
                        inst.CanCollide = false
                        count += 1
                        break
                    end
                end
            end
        end
    end
    safePlaySound(SOUND_NOTIF, 0.5)
    notify("Delete All", count.." objek dihapus!", "success")
end

