-- ========== ESP SYSTEM (DENGAN DRAWING) ==========
local Camera = workspace.CurrentCamera
local espData = {}
local hasDrawing = pcall(function() local t = Drawing.new("Line") t:Remove() end)

if hasDrawing then
    local function createESP(p)
        local lines = {}
        for i=1,8 do
            local l = Drawing.new("Line")
            l.Thickness = 1.5
            l.Color = Color3.fromRGB(50,200,100)
            l.Visible = false
            table.insert(lines,l)
        end
        local nameDraw = Drawing.new("Text")
        nameDraw.Size = 13
        nameDraw.Center = true
        nameDraw.Outline = true
        nameDraw.Color = Color3.new(1,1,1)
        nameDraw.Visible = false
        local healthLine = Drawing.new("Line")
        healthLine.Thickness = 2
        healthLine.Visible = false
        local healthBg = Drawing.new("Line")
        healthBg.Thickness = 2
        healthBg.Color = Color3.fromRGB(40,40,40)
        healthBg.Visible = false
        espData[p] = {box=lines,name=nameDraw,health=healthLine,healthBg=healthBg}
    end

    local function removeESP(p)
        if espData[p] then
            for _,l in pairs(espData[p].box) do l:Remove() end
            espData[p].name:Remove()
            espData[p].health:Remove()
            espData[p].healthBg:Remove()
            espData[p] = nil
        end
    end

    for _,p in pairs(Players:GetPlayers()) do if p~=player then createESP(p) end end
    Players.PlayerAdded:Connect(function(p) if p~=player then createESP(p) end end)
    Players.PlayerRemoving:Connect(removeESP)

    RunService.RenderStepped:Connect(function()
        for p,data in pairs(espData) do
            if not ESPEnabled then
                for _,l in pairs(data.box) do l.Visible=false end
                data.name.Visible=false data.health.Visible=false data.healthBg.Visible=false
                continue
            end
            local char = p.Character
            if not char then continue end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum then continue end
            local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            if not onScreen then
                for _,l in pairs(data.box) do l.Visible=false end
                data.name.Visible=false data.health.Visible=false data.healthBg.Visible=false
                continue
            end
            local myChar = player.Character
            local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local dist = myHRP and math.floor((myHRP.Position-hrp.Position).Magnitude) or 0
            if dist > MaxDistance then
                for _,l in pairs(data.box) do l.Visible=false end
                data.name.Visible=false data.health.Visible=false data.healthBg.Visible=false
                continue
            end
            local scale = Camera:WorldToViewportPoint(hrp.Position+Vector3.new(0,3,0)).Y - Camera:WorldToViewportPoint(hrp.Position-Vector3.new(0,3,0)).Y
            if scale < 0 then scale = 5 end
            local w = scale*0.6 local h = scale*1.2
            local x,y = pos.X, pos.Y
            local left,right = x-w/2, x+w/2
            local top2,bottom = y-h/2, y+h/2
            local c2 = w/4
            local ls = data.box
            ls[1].From=Vector2.new(left,top2)    ls[1].To=Vector2.new(left+c2,top2)
            ls[2].From=Vector2.new(left,top2)    ls[2].To=Vector2.new(left,top2+c2)
            ls[3].From=Vector2.new(right,top2)   ls[3].To=Vector2.new(right-c2,top2)
            ls[4].From=Vector2.new(right,top2)   ls[4].To=Vector2.new(right,top2+c2)
            ls[5].From=Vector2.new(left,bottom)  ls[5].To=Vector2.new(left+c2,bottom)
            ls[6].From=Vector2.new(left,bottom)  ls[6].To=Vector2.new(left,bottom-c2)
            ls[7].From=Vector2.new(right,bottom) ls[7].To=Vector2.new(right-c2,bottom)
            ls[8].From=Vector2.new(right,bottom) ls[8].To=Vector2.new(right,bottom-c2)
            for _,l in pairs(ls) do l.Visible=true end
            if ShowName then
                data.name.Text = ShowDistance and (p.Name.." ["..dist.."]") or p.Name
                data.name.Position = Vector2.new(x,top2-16)
                data.name.Visible = true
            else data.name.Visible = false end
            if ShowHealth then
                local hpPct = hum.MaxHealth>0 and math.clamp(hum.Health/hum.MaxHealth,0,1) or 0
                local barX = right+4
                data.healthBg.From=Vector2.new(barX,top2) data.healthBg.To=Vector2.new(barX,bottom) data.healthBg.Visible=true
                local hpY = bottom-(bottom-top2)*hpPct
                data.health.From=Vector2.new(barX,hpY) data.health.To=Vector2.new(barX,bottom)
                data.health.Color=Color3.fromRGB(255*(1-hpPct),200*hpPct,60*hpPct) data.health.Visible=true
            else data.health.Visible=false data.healthBg.Visible=false end
        end
    end)
else
    print("ESP drawing not supported, disabling ESP")
end

