		if inst:IsA("BasePart") and not (lp.Character and inst:IsDescendantOf(lp.Character)) then
			if e then
				if not origParts[inst] then origParts[inst]={Color=inst.Color} end
				inst.Color = Color3.fromRGB(120,120,120)
			else
				local orig = origParts[inst] if orig then inst.Color = orig.Color end
			end
		end
	end
end
local function applyHideDecals(e)
	local lp = player
	for _, inst in ipairs(workspace:GetDescendants()) do
		if (inst:IsA("Texture") or inst:IsA("Decal")) and not (lp.Character and inst:IsDescendantOf(lp.Character)) then
			if e then
				if not origDecals[inst] then origDecals[inst] = inst.Transparency end
				inst.Transparency = 1
			elseif origDecals[inst] then inst.Transparency = origDecals[inst] end
		end
	end
end
local function applyFlatWater(e)
	local terrain = workspace:FindFirstChild("Terrain") if not terrain then return end
	if e then
		if not origTerrain.water then
			origTerrain.water = {waveSize=terrain.WaterWaveSize, waveSpeed=terrain.WaterWaveSpeed,
				reflectance=terrain.WaterReflectance, transparency=terrain.WaterTransparency}
		end
		terrain.WaterWaveSize=0 terrain.WaterWaveSpeed=0 terrain.WaterReflectance=0 terrain.WaterTransparency=1
	else
		local w = origTerrain.water
		if w then terrain.WaterWaveSize=w.waveSize terrain.WaterWaveSpeed=w.waveSpeed
			terrain.WaterReflectance=w.reflectance terrain.WaterTransparency=w.transparency end
	end
end
local function applyLowRender(e)
	pcall(function()
		local gs = game:GetService("UserSettings"):GetService("UserGameSettings")
		gs.SavedQualityLevel = e and Enum.SavedQualitySetting.QualityLevel1 or Enum.SavedQualitySetting.Automatic
		gs:Apply()
	end)
	pcall(function() settings().Rendering.QualityLevel = e and 1 or 21 end)
end
local function applyHighBright(e) Lighting.Brightness = e and 2 or origLighting2.brightness end
local function applyLowAnim(e) pcall(function() settings().Physics.AllowSleep = e end) end
local function refreshAll()
	applyLowShadow(fpsState.lowShadow) applyNoPost(fpsState.noPost)
	applyFlatMat(fpsState.flatMat) applyNoColor(fpsState.noColor)
	applyHideDecals(fpsState.hideDecals) applyFlatWater(fpsState.flatWater)
	applyLowRender(fpsState.lowRender) applyHighBright(fpsState.highBright)
	applyLowAnim(fpsState.lowAnim)
end

