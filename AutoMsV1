            end
        end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.CFrame = CFrame.new(hrp.Position.X, 10, hrp.Position.Z) end
    end)
    notify("Under Pit", "Keluar dari bawah map.", "off")
end

