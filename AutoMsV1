local underPitBodyPos = nil
local function startUnderPit()
    underPitEnabled = true
    task.spawn(function()
        pcall(function()
            local char = player.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            local seat = hum and hum.SeatPart
            if seat then
                local vehicle = seat:FindFirstAncestorOfClass("Model")
                if vehicle and vehicle.PrimaryPart then
                    local cf = vehicle.PrimaryPart.CFrame
                    vehicle:SetPrimaryPartCFrame(CFrame.new(cf.X, cf.Y - 60, cf.Z))
                    underPitBodyPos = Instance.new("BodyPosition", vehicle.PrimaryPart)
                    underPitBodyPos.Position = Vector3.new(cf.X, cf.Y - 60, cf.Z)
                    underPitBodyPos.MaxForce = Vector3.new(0, 1e5, 0)
                    underPitBodyPos.D = 1000
                    underPitBodyPos.P = 10000
                    return
                end
            end
            hrp.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y - 60, hrp.Position.Z)
        end)
    end)
    underPitConn = RunService.Stepped:Connect(function()
        if not underPitEnabled then return end
        pcall(function()
            local char = player.Character
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            local seat = hum and hum.SeatPart
            if seat then
                local vehicle = seat:FindFirstAncestorOfClass("Model")
                if vehicle and vehicle.PrimaryPart then
                    local pp = vehicle.PrimaryPart
                    if pp.Position.Y > -30 then
                        vehicle:SetPrimaryPartCFrame(CFrame.new(pp.Position.X, -50, pp.Position.Z))
                        pp.AssemblyLinearVelocity = Vector3.zero
                    end
                end
            else
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp and hrp.Position.Y > -30 then
                    hrp.CFrame = CFrame.new(hrp.Position.X, -50, hrp.Position.Z)
                end
            end
        end)
    end)
    notify("Under Pit", "Di bawah map! Aktif.", "success")
end

local function stopUnderPit()
    underPitEnabled = false
    if underPitConn then underPitConn:Disconnect() underPitConn = nil end
    if underPitBodyPos then underPitBodyPos:Destroy() underPitBodyPos = nil end
    pcall(function()
        local char = player.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local seat = hum and hum.SeatPart
        if seat then
            local vehicle = seat:FindFirstAncestorOfClass("Model")
            if vehicle and vehicle.PrimaryPart then
                local cf = vehicle.PrimaryPart.CFrame
                vehicle:SetPrimaryPartCFrame(CFrame.new(cf.X, 10, cf.Z))
                vehicle.PrimaryPart.AssemblyLinearVelocity = Vector3.zero
