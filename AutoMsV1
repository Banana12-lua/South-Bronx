    brightness = Lighting.Brightness,
    globalShadows = Lighting.GlobalShadows,
    postEffects = {},
}
for _,v in ipairs(Lighting:GetChildren()) do
    if v:IsA("PostEffect") then table.insert(origLighting.postEffects, v:Clone()) end
end

local origParts, origDecals, origTerrain = {},{},{}
local fpsState = {lowShadow=false,noPost=false,flatMat=false,noColor=false,hideDecals=false,flatWater=false,lowRender=false,highBright=false,lowAnim=false}

local function applyLowShadow(e) Lighting.GlobalShadows = not e end
local function applyNoPost(e)
    if e then
        for _,v in ipairs(Lighting:GetChildren()) do if v:IsA("PostEffect") then v:Destroy() end end
        Lighting.FogEnd = 9e9
    else
        Lighting.FogEnd = origLighting.fogEnd
        for _,v in ipairs(origLighting.postEffects) do v:Clone().Parent = Lighting end
    end
end
local function applyFlatMat(e)
    for _,inst in ipairs(workspace:GetDescendants()) do
        if inst:IsA("BasePart") and not (player.Character and inst:IsDescendantOf(player.Character)) then
            if e then
                if not origParts[inst] then origParts[inst]={Material=inst.Material,Reflectance=inst.Reflectance,Color=inst.Color} end
                inst.Material = Enum.Material.SmoothPlastic inst.Reflectance = 0
            else
                local o = origParts[inst] if o then inst.Material=o.Material inst.Reflectance=o.Reflectance inst.Color=o.Color end
            end
        end
    end
end
local function applyHideDecals(e)
    for _,inst in ipairs(workspace:GetDescendants()) do
        if (inst:IsA("Texture") or inst:IsA("Decal")) and not (player.Character and inst:IsDescendantOf(player.Character)) then
            if e then
                if not origDecals[inst] then origDecals[inst]=inst.Transparency end
                inst.Transparency = 1
            elseif origDecals[inst] then inst.Transparency = origDecals[inst] end
        end
    end
end
local function applyFlatWater(e)
    local t = workspace:FindFirstChild("Terrain") if not t then return end
    if e then
        if not origTerrain.water then origTerrain.water={waveSize=t.WaterWaveSize,waveSpeed=t.WaterWaveSpeed,reflectance=t.WaterReflectance,transparency=t.WaterTransparency} end
        t.WaterWaveSize=0 t.WaterWaveSpeed=0 t.WaterReflectance=0 t.WaterTransparency=1
    else
        local w=origTerrain.water if w then t.WaterWaveSize=w.waveSize t.WaterWaveSpeed=w.waveSpeed t.WaterReflectance=w.reflectance t.WaterTransparency=w.transparency end
    end
end
local function applyLowRender(e)
    pcall(function()
        local gs = game:GetService("UserSettings"):GetService("UserGameSettings")
        gs.SavedQualityLevel = e and Enum.SavedQualitySetting.QualityLevel1 or Enum.SavedQualitySetting.Automatic
        gs:Apply()
    end)
    pcall(function() settings().Rendering.QualityLevel = e and 1 or 21 end)
end
local function applyHighBright(e) Lighting.Brightness = e and 2 or origLighting.brightness end
local function applyLowAnim(e) pcall(function() settings().Physics.AllowSleep = e end) end

