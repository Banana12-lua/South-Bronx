-- ========== ANTI HIT ==========
local SAFE_POS = Vector3.new(579.0, 3.5, -539.7)
local MALL_POS = Vector3.new(-725.4, 4.8, 587.4)
local APPROACH_RADIUS = 20
local NPC_ZONE_POS = Vector3.new(510.7584, 3.5872, 600.3163)
local NPC_ZONE_RADIUS = 35

local function startAntiHit()
    pcall(function()
        local char = player.Character or player.CharacterAdded:Wait()
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        if antiHitConn then antiHitConn:Disconnect() end
        antiHitConn = hum.HealthChanged:Connect(function(hp)
            if not ANTI_HIT then return end
            if hp < hum.MaxHealth and hp > 0 then
                vehicleTeleport(CFrame.new(SAFE_POS))
            end
        end)
    end)
end

local function startAntiApproach(statusLbl)
    if antiApprConn then antiApprConn:Disconnect() end
    antiApprConn = RunService.Heartbeat:Connect(function()
        if not ANTI_HIT then return end
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        if (hrp.Position - NPC_ZONE_POS).Magnitude <= NPC_ZONE_RADIUS then
            if statusLbl then statusLbl.Text = "Paused (zona NPC)" end
            return
        end
        for _, plr in pairs(Players:GetPlayers()) do
            if plr == player then continue end
            local c = plr.Character
            local h = c and c:FindFirstChild("HumanoidRootPart")
            if h and (hrp.Position - h.Position).Magnitude <= APPROACH_RADIUS then
                if statusLbl then statusLbl.Text = plr.Name.." mendekat!" end
                vehicleTeleport(CFrame.new(MALL_POS))
                task.wait(1)
                return
            end
        end
        if statusLbl then statusLbl.Text = "Aktif | R:"..APPROACH_RADIUS end
    end)
end

local function stopAntiHit(statusLbl)
    if antiHitConn then antiHitConn:Disconnect() antiHitConn = nil end
    if antiApprConn then antiApprConn:Disconnect() antiApprConn = nil end
    if statusLbl then statusLbl.Text = "Idle" end
end

