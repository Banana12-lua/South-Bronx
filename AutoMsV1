-- ========== AUTO FARM ==========
local function autoBuy()
    for i = 1, buyAmount do
        if not running and not autoFarmRunning then break end
        buyRemote:FireServer("Water")       task.wait(0.35)
        buyRemote:FireServer("Sugar Block Bag") task.wait(0.35)
        buyRemote:FireServer("Gelatin")     task.wait(0.35)
        buyRemote:FireServer("Empty Bag")   task.wait(0.45)
    end
end

local function farmCook()
    if equipTool("Water") then holdE(0.7) task.wait(20) end
    if equipTool("Sugar Block Bag") then holdE(0.7) task.wait(1) end
    if equipTool("Gelatin") then holdE(0.7) task.wait(1) end
    task.wait(45)
    if equipTool("Empty Bag") then holdE(0.7) task.wait(1) end
end

local function autoSell()
    local bags = {"Small Marshmallow Bag","Medium Marshmallow Bag","Large Marshmallow Bag"}
    for _,bag in pairs(bags) do
        while countItem(bag) > 0 and (autoFarmRunning or running) do
            if equipTool(bag) then holdE(0.7) task.wait(0.8) else break end
        end
    end
end

local function freezeVehicle(vehicle)
    if not vehicle or not vehicle.PrimaryPart then return end
    local p = vehicle.PrimaryPart
    pcall(function()
        p.AssemblyLinearVelocity = Vector3.zero
        p.AssemblyAngularVelocity = Vector3.zero
    end)
end

local function vehicleTP_auto(target)
    if autoFarmStopping then return end
    pcall(function()
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local seat = hum and hum.SeatPart
        if not seat then return end
        local vehicle = seat:FindFirstAncestorOfClass("Model")
        if not vehicle then return end
        if not vehicle.PrimaryPart then vehicle.PrimaryPart = seat end
        local rot = vehicle.PrimaryPart.CFrame - vehicle.PrimaryPart.Position
        vehicle:SetPrimaryPartCFrame(CFrame.new(target + Vector3.new(0,2,0)) * rot)
        freezeVehicle(vehicle)
        task.wait(0.3)
        vehicle:SetPrimaryPartCFrame(CFrame.new(target) * rot)
        freezeVehicle(vehicle)
        task.wait(0.4)
    end)
end

local farmID = 0
local function startFarmLoop()
    farmLoopRunning = true
    farmID += 1
    local currentID = farmID
    task.spawn(function()
        local apartPos = pcall(function()
            return player.Character.HumanoidRootPart.Position
        end) and player.Character.HumanoidRootPart.Position or Vector3.new(510,4,601)
        while farmLoopRunning and autoFarmRunning and currentID == farmID do
            vehicleTP_auto(storePos) task.wait(0.5)
